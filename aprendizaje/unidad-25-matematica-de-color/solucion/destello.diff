     if (estado_fase_mundo_avanza(&partida))          /* Humo y pájaros (en pausa, quietos). */
@@ -443,4 +457,21 @@ void pantalla_fase1_vblank(void)
             dmaCopyCGram((u8 *)&ninja3_pal, 128 + 48, 32);
