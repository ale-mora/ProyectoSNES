+/* Salta una vez y devuelve la altura máxima en píxeles. Con `mantener` a 1, B sigue
+   mantenida (m.saltar) todo el salto; con 0, solo se pulsa en el primer cuadro. */
+static u16 altura_maxima(u8 mantener, u16 *cuadros_en_aire)
+{
+    Cuerpo c;
+    Mando m;
+    u16 max_alto = 0, n = 0;
+
+    preparar(&c, &m);
+    m.saltar_pulsado = 1;                            /* El cuadro del despegue.             */
+    m.saltar = mantener;
+    do
+    {
+        mundo_actualizar(&c, &m);
+        m.saltar_pulsado = 0;                        /* Solo se PULSA una vez.              */
+        n++;
+        if (mundo_altura(&c) > max_alto)
+        {
+            max_alto = mundo_altura(&c);
+        }
+    } while (c.z > 0 && n < 100);
+    *cuadros_en_aire = n;
+    return max_alto;
+}
