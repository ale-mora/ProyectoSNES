     }
+
+    /* Salto de altura variable: mantener B mientras sube lo alarga (ejercicio 22). */
+    {
+        u16 aire_corto, aire_largo;
+        u16 corto = altura_maxima(0, &aire_corto);   /* Tocar B: el salto de siempre.       */
+        u16 largo = altura_maxima(1, &aire_largo);   /* Mantener B: más alto...             */
+
+        COMPROBAR(corto >= 30 && corto <= 40);       /* ...el corto no cambia (39 px)...    */
+        COMPROBAR(largo >= 48 && largo <= 56);       /* ...y el largo llega a ~51 px.       */
+        COMPROBAR(aire_largo > aire_corto);          /* Y tarda más en volver.              */
