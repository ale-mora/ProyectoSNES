+/*--- NUMERO: qué versión de numero usa el HUD (unidad 15) ---------------------------
+    Con -DHUD_NUMERO_ASM, la de ensamblador (juego/hud_numero.asm); si no, la de C.
+    La de C se queda siempre: comprobar_numero la usa de referencia. */
+#ifdef HUD_NUMERO_ASM
+extern u16 *hud_numero(u16 *p, s16 valor);   /* En juego/hud_numero.asm.               */
+#define NUMERO hud_numero
+/* Valores de prueba: ceros, cambios de cifra, negativos y los dos extremos de s16. */
+static const s16 PRUEBAS_NUMERO[14] = {0, 9, 10, 99, 100, 1234, 10000, 32767,
+                                       -1, -9, -10, -1000, -32767, -32768};
+static u8 numero_iguales;          /* Cuántos de los 14 valores dan lo mismo en C y asm. */
+static u16 numero_c[8];            /* Lo que escribe la versión en C...                  */
+static u16 numero_asm[8];          /* ...y la de ensamblador.                            */
+
+/*--- comprobar_numero: C frente a asm con los 14 valores, una vez al empezar ------*/
+static void comprobar_numero(void)
+{
+    const s16 *v = PRUEBAS_NUMERO;
+    u16 *fin_c;
+    u16 *fin_asm;
+    u8 k;
+    u8 j;
+    u8 largo;
+
+    numero_iguales = 0;
+    for (k = 0; k < 14; k++, v++)
+    {
+        memset(numero_c, 0xFF, sizeof(numero_c));        /* Basura igual en los dos,  */
+        memset(numero_asm, 0xFF, sizeof(numero_asm));    /* para ver si sobra algo.   */
+        fin_c = numero(numero_c, *v);
+        fin_asm = hud_numero(numero_asm, *v);
+        largo = (u8)((u16)fin_c - (u16)numero_c);        /* Bytes escritos en C (restar
+                                                            punteros dividiría por 2). */
+        if (largo != (u8)((u16)fin_asm - (u16)numero_asm))
+        {
+            continue;                                    /* Distinto largo: falla.    */
+        }
+        for (j = 0; j < 8; j++)
+        {
+            if (numero_c[j] != numero_asm[j])
+            {
+                break;                                   /* Una palabra distinta.     */
+            }
+        }
+        if (j == 8)
+        {
+            numero_iguales++;                            /* Idénticos, sobras incluidas. */
+        }
+    }
+}
+#else
+#define NUMERO numero
+#endif
