+class PruebaPiezas(unittest.TestCase):
+    """Unidad 19, ejercicio B: las piezas que faltan (zarza.png...) se dejan en la
+    MISMA carpeta que la hoja de Pixellab del suelo."""
+
+    def test_la_hoja_no_es_una_pieza(self):
+        """Una zarza.png más nueva que la hoja no debe tomarse por la hoja."""
+        import os
+        import time
+        with tempfile.TemporaryDirectory() as d:
+            d = Path(d)
+            hoja_doble(d / "pixellab-tileset-suelo.png")
+            Image.new("RGBA", (T, T), (0, 0, 0, 0)).save(d / "zarza.png")
+            ahora = time.time()
+            os.utime(d / "zarza.png", (ahora + 60, ahora + 60))       # la más reciente
+            self.assertEqual(pn.hoja_de_suelo(d).name, "pixellab-tileset-suelo.png")
+
+    def test_zarza_de_pixellab(self):
+        """Con una pieza, cada celda de zarza lleva SUS píxeles (no el marcador)."""
+        g = [[pn.VACIO] * pn.COLS for _ in range(pn.FILAS)]
+        g[10][3] = pn.ZARZA
+        pieza = Image.new("RGBA", (T, T), (0, 0, 0, 0))
+        pieza.putpixel((0, 15), (10, 200, 10, 255))
+        capa = Image.new("RGBA", (64, 176), (0, 0, 0, 0))
+        pn.poner_zarzas(capa, g, (0, 0, 0), (255, 255, 255), pieza)
+        self.assertEqual(capa.getpixel((48, 175)), (10, 200, 10, 255))   # celda (3, 10)
+        self.assertEqual(capa.getpixel((50, 165))[3], 0)    # el marcador habría pintado aquí
+
